{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "types": [
      "nitro/vite",
      "@unplugin-pwa/core/info",
      "@unplugin-pwa/core/pwa-assets"
    ],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "test"
  ]
}
