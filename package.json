{
  "name": "@vite-pwa/tanstack",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@11.25.0",
  "description": "Zero-config PWA for TanStack",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/tanstack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/tanstack.git"
  },
  "bugs": "https://github.com/vite-pwa/tanstack/issues",
  "keywords": [
    "tanstack",
    "tanstack start",
    "workbox",
    "pwa",
    "vite",
    "nitro",
    "unplugin-pwa"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./create-nitro-pwa-context": "./dist/create-nitro-pwa-context.mjs",
    "./create-pwa-context": "./dist/create-pwa-context.mjs",
    "./vite/build-sw": "./dist/vite/build-sw.mjs",
    "./vite/nitro": "./dist/vite/nitro.mjs",
    "./vite/nitro/config": "./dist/vite/nitro/config.mjs",
    "./react-components": "./dist/react-components.mjs",
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "update:deps": "taze -I",
    "test:typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@vite-pwa/assets-generator": "^1.0.0 || ^2.0.0",
    "magicast": "^0.5.0",
    "nitro": "^3.0.0-0",
    "rolldown": "^1.0.0-0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@vite-pwa/assets-generator": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@unplugin-pwa/core": "catalog:pwa",
    "@unplugin-pwa/inspector": "catalog:pwa",
    "@unplugin-pwa/vite": "catalog:pwa",
    "@vite-pwa/workbox-build": "catalog:pwa",
    "@vite-pwa/workbox-swkit": "catalog:pwa",
    "@vite-pwa/workbox-window": "catalog:pwa"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@antfu/ni": "catalog:utils",
    "@arethetypeswrong/core": "catalog:utils",
    "@types/debug": "catalog:types",
    "@types/node": "catalog:types",
    "@types/react": "catalog:tanstackreact",
    "@vite-pwa/assets-generator": "catalog:pwa",
    "@vitejs/devtools": "catalog:utils",
    "eslint": "catalog:eslint",
    "eslint-plugin-antfu": "catalog:eslint",
    "https-localhost": "catalog:utils",
    "nitro": "catalog:utils",
    "publint": "catalog:utils",
    "react": "catalog:tanstackreact",
    "taze": "catalog:utils",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "vite": "catalog:utils"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
